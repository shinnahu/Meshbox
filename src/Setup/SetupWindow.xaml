<Window x:Class="MeshboxSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meshbox Setup" Width="680" Height="460" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" Foreground="#DBDEE1"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="Brand" StartPoint="0.15,0" EndPoint="0.85,1">
      <GradientStop Color="#5EA8FF" Offset="0"/>
      <GradientStop Color="#3B83FF" Offset="0.5"/>
      <GradientStop Color="#1A50F0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Muted" Color="#9AA0AA"/>
    <SolidColorBrush x:Key="Card" Color="#2B2D31"/>

    <!-- shown only when moving around with the keyboard -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="#8AB8FF"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#DBDEE1"/>
      <Setter Property="Background" Value="#2B2D31"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B5BAC1"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DBDEE1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#5C5F68" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M4.5,10 L8.5,13.5 L15,6.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#3B83FF"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#3B83FF"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#8AB8FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Feature" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C9CDD4"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" CornerRadius="16" Background="#1E1F22" Margin="18" BorderBrush="#34363C" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- brand panel -->
      <Border Grid.Column="0" CornerRadius="15,0,0,15" Background="{StaticResource Brand}">
        <Grid Margin="28,34,26,26">
          <StackPanel VerticalAlignment="Top">
            <Border Width="92" Height="92" HorizontalAlignment="Left" CornerRadius="22">
              <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.35" Color="#0B2A8F"/></Border.Effect>
              <Image x:Name="Logo" Width="92" Height="92" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="Meshbox" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="0,20,0,0"/>
            <TextBlock x:Name="VersionText" Text="Version" Foreground="#DCE9FF" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock TextWrapping="Wrap" Foreground="#EEF4FF" FontSize="13" LineHeight="19"
                       Text="Fast viewer and organizer for FBX, Blender and glTF models."/>
            <TextBlock TextWrapping="Wrap" Foreground="#C4D8FF" FontSize="12" Margin="0,10,0,0"
                       Text="For your Windows account only. No admin rights needed."/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- content -->
      <Grid Grid.Column="1" Margin="34,16,22,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="CloseX" Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource IconBtn}" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#B5BAC1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>

        <Grid Grid.Row="1" Margin="0,6,10,0">
          <!-- welcome -->
          <StackPanel x:Name="PageWelcome">
            <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" Text="Install Meshbox"/>
            <TextBlock x:Name="WelcomeText" Style="{StaticResource Body}" Margin="0,8,0,18" Text="View, organize and export your 3D models for Unity."/>
            <TextBlock Style="{StaticResource Feature}"><Run Foreground="#5EA8FF" Text="●  "/>Start menu shortcut</TextBlock>
            <TextBlock Style="{StaticResource Feature}"><Run Foreground="#5EA8FF" Text="●  "/>"Open with" for FBX, BLEND, GLB, OBJ and more</TextBlock>
            <TextBlock Style="{StaticResource Feature}"><Run Foreground="#5EA8FF" Text="●  "/>Uninstall any time from Settings &gt; Apps</TextBlock>
            <TextBlock Text="Install location" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="11,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#7FB2FF" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="LocationText" FontSize="12.5" Foreground="#C9CDD4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <CheckBox x:Name="DesktopBox" Content="Also add a desktop shortcut" Margin="0,16,0,0"/>
            <Border x:Name="Note" Visibility="Collapsed" Background="#2E2A1F" CornerRadius="8" Padding="12,9" Margin="0,16,0,0">
              <TextBlock x:Name="NoteText" Foreground="#F6D38B" TextWrapping="Wrap" FontSize="12.5"/>
            </Border>
          </StackPanel>

          <!-- working -->
          <StackPanel x:Name="PageWork" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="WorkTitle" Style="{StaticResource H1}" Text="Installing Meshbox"/>
            <TextBlock x:Name="StepText" Style="{StaticResource Body}" Margin="0,8,0,22" Text="Starting"/>
            <Grid>
              <Border x:Name="Track" Height="10" CornerRadius="5" Background="{StaticResource Card}"/>
              <Border x:Name="Fill" Height="10" CornerRadius="5" Background="{StaticResource Brand}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="PctText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" Text="0%"/>
          </StackPanel>

          <!-- done -->
          <StackPanel x:Name="PageDone" Visibility="Collapsed">
            <Grid Width="56" Height="56" HorizontalAlignment="Left">
              <Ellipse Fill="#1F3D2B"/>
              <Path Data="M17,29 L25,37 L40,20" Stroke="#4ADE80" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Margin="0,18,0,0" Text="Meshbox is installed"/>
            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="Find it in the Start menu."/>
            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="To open .fbx files with it: right-click an .fbx file &gt; Open with &gt; Choose another app &gt; Meshbox &gt; Always."/>
            <CheckBox x:Name="LaunchBox" Content="Open Meshbox now" IsChecked="True" Margin="0,22,0,0"/>
          </StackPanel>

          <!-- error -->
          <StackPanel x:Name="PageError" Visibility="Collapsed">
            <Grid Width="56" Height="56" HorizontalAlignment="Left">
              <Ellipse Fill="#3D1F22"/>
              <Path Data="M28,16 L28,31 M28,39 L28,40" Stroke="#FF8E91" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
            <TextBlock Style="{StaticResource H1}" Margin="0,18,0,0" Text="Setup could not finish"/>
            <TextBox x:Name="ErrorText" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource Card}" Foreground="#FF9C9F"
                     BorderThickness="0" Padding="10,8" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="Nothing was changed if the copy failed: your current Meshbox still works."/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,10,0">
          <Button x:Name="SecondaryBtn" Style="{StaticResource Ghost}" Content="Cancel" Margin="0,0,10,0"/>
          <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Content="Install" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
